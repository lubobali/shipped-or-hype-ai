# Copy to a file only you can read (chmod 600), fill in, load before running.
# Never commit the filled file (*.env is in .gitignore).

# OpenRouter key. Give it its own monthly credit limit (a few dollars is plenty).
OPENROUTER_API_KEY=
# Optional. Default: anthropic/claude-sonnet-5.5
RADAR_MODEL=

# Where the email goes. Port 465 = TLS, any other port = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RADAR_EMAIL_TO=
# Optional. Default: SMTP_USER
RADAR_EMAIL_FROM=

# Optional: where it remembers what earlier emails showed. Default: ./state
RADAR_STATE_DIR=

# Optional: podcast transcripts you already have (Postgres, read-only login).
# Table or view with columns: audio_url, episode_title, transcript.
RADAR_TRANSCRIPTS_DB_URL=
RADAR_TRANSCRIPTS_TABLE=podcast_transcripts
